# URL base của backend NestJS (dev: http://localhost:3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Khoá bí mật mã hoá JWE session cookie cho NextAuth / Auth.js v5 (bắt buộc)
# Có thể sinh ngẫu nhiên bằng: openssl rand -hex 32 hoặc npx auth secret
AUTH_SECRET=

# Canonical URL của frontend (dev: http://localhost:3000)
AUTH_URL=http://localhost:3000
