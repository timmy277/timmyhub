// Module cart — giỏ hàng bền vững theo user. Giỏ khách vãng lai không nằm trong Postgres, chỉ Redis TTL 7 ngày.
// Giỏ khoá theo variantId (không phải productId) theo mô hình ở docs/02-domain/product-variant.md.
// Nguồn: docs/02-domain/schemas/cart-service.prisma.md.

model Cart {
    id        String     @id @default(cuid())
    userId    String     @unique
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    items     CartItem[]

    @@map("carts")
}

model CartItem {
    id                  String   @id @default(cuid())
    cartId              String
    // tham chiếu logic sang module catalog, không @relation
    productId           String
    variantId           String
    quantity            Int      @default(1)
    // lưu tạm để hiển thị nhanh mà không gọi lại catalog mỗi lần mở giỏ — có thể lệch,
    // luôn kiểm lại giá thật lúc checkout (data-architecture.md §3)
    cachedPriceSnapshot Decimal? @db.Decimal(14, 2)
    isValid             Boolean  @default(true)
    invalidReason       String?
    savedForLater       Boolean  @default(false)
    addedAt             DateTime @default(now())
    cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

    @@unique([cartId, variantId])
    @@index([variantId])
    @@map("cart_items")
}
