// Module chat — hội thoại/tin nhắn realtime (kế thừa, bọc trong Conversation mới), ticket hỗ trợ có SLA, và
// tranh chấp ba bên. Vòng đời đầy đủ của Dispute (state machine 12 trạng thái, bốn kết cục, mốc thời hạn và hệ
// quả quá hạn) mô tả chi tiết ở docs/02-domain/order-dispute.md — không lặp lại văn xuôi ở đây.
// Nguồn: docs/02-domain/schemas/chat-service.prisma.md.

model Conversation {
    id                String        @id @default(cuid())
    buyerId           String
    sellerId          String
    // tham chiếu tuỳ chọn nếu hội thoại phát sinh từ một đơn hàng
    orderId           String?
    lastMessageAt     DateTime?
    isBlockedByBuyer  Boolean       @default(false)
    isBlockedBySeller Boolean       @default(false)
    createdAt         DateTime      @default(now())
    messages          ChatMessage[]

    @@unique([buyerId, sellerId])
    @@index([sellerId, lastMessageAt])
    @@map("conversations")
}

model ChatMessage {
    id                 String       @id @default(cuid())
    conversationId     String
    senderId           String
    content            String?
    imageUrls          String[]     @default([])
    // gắn sản phẩm/đơn hàng vào tin nhắn — FEAT-CHT-003
    attachedProductId  String?
    attachedOrderId    String?
    isRead             Boolean      @default(false)
    createdAt          DateTime     @default(now())
    conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@map("chat_messages")
}

/// Ticket hỗ trợ có SLA — FEAT-CHT-005/007
model SupportTicket {
    id           String    @id @default(cuid())
    userId       String
    subject      String
    category     String
    // LOW | NORMAL | HIGH | URGENT
    priority     String    @default("NORMAL")
    // OPEN | ASSIGNED | RESOLVED | CLOSED
    status       String    @default("OPEN")
    assignedToId String?
    slaDeadline  DateTime
    slaBreached  Boolean   @default(false)
    resolvedAt   DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    @@index([status, slaDeadline])
    @@index([assignedToId])
    @@map("support_tickets")
}

/// Tranh chấp đơn hàng ba bên — state machine đầy đủ ở docs/02-domain/order-dispute.md §2
model Dispute {
    id                    String         @id @default(cuid())
    orderId               String
    orderItemId           String
    buyerId               String
    sellerId              String
    // NOT_RECEIVED | DAMAGED | WRONG_ITEM | MISSING_PART | NOT_AS_DESCRIBED | COUNTERFEIT | CHANGED_MIND
    reasonCode            String
    description           String
    evidenceUrls          String[]       @default([])
    // OPENED | SELLER_RESPONDED | AUTO_RESOLVED_BUYER | ESCALATED | UNDER_REVIEW | NEED_MORE_EVIDENCE
    // | AGREED | RESOLVED | APPEALED | CLOSED (order-dispute.md §2)
    status                String         @default("OPENED")
    // FULL_REFUND | PARTIAL_REFUND | SELLER_WINS | REFUND_WITH_RETURN
    resolutionType        String?
    refundAmount          Decimal?       @db.Decimal(14, 2)
    assignedToId          String?
    sellerRespondDeadline DateTime
    evidenceDeadline      DateTime?
    appealDeadline        DateTime?
    createdAt             DateTime       @default(now())
    updatedAt              DateTime      @updatedAt
    events                DisputeEvent[]

    @@index([orderId])
    @@index([status, sellerRespondDeadline])
    @@index([assignedToId])
    @@map("disputes")
}

/// Nhật ký bất biến từng bước chuyển trạng thái tranh chấp — order-dispute.md §2
model DisputeEvent {
    id                   String   @id @default(cuid())
    disputeId            String
    fromStatus           String?
    toStatus             String
    actorId              String?
    actorRole            String?
    note                 String?
    evidenceSnapshotUrls String[] @default([])
    createdAt            DateTime @default(now())
    dispute              Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

    @@index([disputeId, createdAt])
    @@map("dispute_events")
}

// Ràng buộc viết tay bắt buộc (không sinh được bằng @@unique của Prisma) — mỗi orderItemId chỉ có một
// tranh chấp đang mở:
//   CREATE UNIQUE INDEX dispute_one_open_per_item ON "disputes" ("orderItemId") WHERE "status" NOT IN ('CLOSED');
