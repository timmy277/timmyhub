# Sao chép file này thành .env và điền giá trị thật.
# KHÔNG bao giờ commit .env — luật cứng #17 CLAUDE.md.
# Mật khẩu DB chỉ đến qua biến môi trường CI/runtime, không qua file trong repo.

# Connection string Postgres (Supabase hoặc self-hosted). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/timmyhub"

# Pool size cho Prisma adapter
DB_POOL_MAX=20

# Seed password cho tài khoản mẫu (chỉ dev local)
SEED_PASSWORD="ChangeMe_InProd_123"
