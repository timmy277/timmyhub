# Xem docs/01-architecture/security.md — JWT access token ký RS256.
# Chỉ đọc TÊN biến ở đây (luật cứng #17 CLAUDE.md), không điền giá trị thật.
# Tự sinh keypair, ví dụ: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
# Origin được gọi API từ browser, phân tách bằng dấu phẩy (FE dev chạy cổng 3000)
FRONTEND_URL=http://localhost:3000

# ============================================================
# Supabase Storage (S3-compatible)
# Lấy từ: Supabase Dashboard → Storage → S3 Configuration
# ============================================================
# Endpoint dạng: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
# Region hiển thị trong S3 Configuration (vd: ap-northeast-2)
S3_REGION=
# Access Key ID sinh từ Supabase Dashboard → Storage → S3 Configuration
S3_ACCESS_KEY_ID=
# Secret Access Key sinh từ Supabase Dashboard
S3_SECRET_ACCESS_KEY=
# Tên bucket đã tạo trong Supabase Storage
S3_BUCKET=
# URL gốc để xem file public. StorageService ghép: ${S3_PUBLIC_URL_PREFIX}/${key}
# Dạng: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
S3_PUBLIC_URL_PREFIX=
