{
  "name": "timmyhub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,mjs}": [
      "pnpm -C frontend exec eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "backend/**/*.ts": [
      "pnpm -C backend exec eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{ts,js,mjs,cjs,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7"
  }
}
